# Copia este archivo como .env y pega tus credenciales de Supabase
# (Dashboard -> Project Settings -> API Keys). Nunca subas .env a Git.
# Solo la URL y la PUBLISHABLE key: todo EXPO_PUBLIC_* queda en el bundle de la app.
# La key de Gemini NO va aquí: es un secreto de las Edge Functions
#   npx supabase secrets set GEMINI_API_KEY=TU_CLAVE
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
